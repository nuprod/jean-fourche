<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_orders_inherit"
              name="My Sales Orders (FR)"
              inherit_id="sale.portal_my_orders">

        <!-- Remplacement du titre de la barre de recherche -->
        <xpath expr="//t[@t-call='portal.portal_searchbar']/t[@t-set='title']" position="replace">
            <t t-set="title">Vos commandes</t>
        </xpath>

        <!-- Remplacement du message "aucune commande" -->
        <xpath expr="//div[@t-if='not orders']" position="replace">
            <div t-if="not orders" class="alert alert-warning" role="alert">
                Il n'y a actuellement pas de commandes pour votre compte.
            </div>
        </xpath>

        <!-- Remplacement du thead (colonnes) -->
        <xpath expr="//t[@t-call='portal.portal_table']/thead" position="replace">
            <thead>
                <tr class="active">
                    <th>
                        <span class="d-none d-md-inline">Bon de commande #</span>
                        <span class="d-block d-md-none">Réf.</span>
                    </th>
                    <th class="text-center">Référence client</th>
                    <th class="text-end">Date de la commande</th>
                    <th class="text-end">Date de livraison estimée</th>
                    <th class="text-end">Total</th>
                    <th class="text-end">Statut livraison</th>
                </tr>
            </thead>
        </xpath>

        <!-- Remplacement des lignes du tableau -->
        <xpath expr="//t[@t-foreach='orders']" position="replace">
            <t t-foreach="orders" t-as="order">
                <tr>
                    <td><a t-att-href="order.get_portal_url()"><t t-out="order.name"/></a></td>
                    <td class="text-center"><span t-field="order.client_order_ref"/></td>
                    <td class="text-end">
                        <span t-field="order.date_order" t-options="{'widget': 'date'}"/>&#160;
                        <span class="d-none d-md-inline" t-field="order.date_order" t-options="{'time_only': True}"/>
                    </td>
                    <td class="text-end">
                        <t t-if="order.delivery_status == 'full'">
                            <span t-field="order.effective_date" t-options='{"widget": "date"}'/>
                        </t>
                        <t t-else="">
                            <span t-if="order.commitment_date" t-field="order.commitment_date" t-options='{"widget": "date"}'/>
                            <span t-else="">en cours de planification</span>
                        </t>
                    </td>
                    <td class="text-end"><span t-field="order.amount_total"/></td>
                    <td class="text-end"><span t-field="order.delivery_status"/></td>
                </tr>
            </t>
        </xpath>

    </template>
</odoo>