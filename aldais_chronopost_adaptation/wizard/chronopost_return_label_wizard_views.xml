<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="chronopost_return_label_wizard_form" model="ir.ui.view">
        <field name="name">chronopost.return.label.wizard.form</field>
        <field name="model">chronopost.return.label.wizard</field>
        <field name="arch" type="xml">
            <form string="Étiquette de retour Chronopost">
                <field name="state" invisible="1"/>
                <group>
                    <group>
                        <field name="carrier_id"/>
                        <field name="partner_id"/>
                        <field name="return_partner_id"/>
                        <field name="sale_order_id" invisible="1"/>
                    </group>
                    <group>
                        <field name="weight"/>
                        <field name="height"/>
                        <field name="length"/>
                        <field name="width"/>
                        <field name="number_of_parcel"/>
                    </group>
                </group>
                <group invisible="not carrier_id or carrier_id.chronopost_product_code != '6C'">
                    <field name="content1"/>
                    <field name="customs_value"/>
                </group>
                <group string="Résultat" invisible="state != 'done'">
                    <field name="tracking_number"/>
                    <field name="label_data" filename="label_filename"/>
                    <field name="label_filename" invisible="1"/>
                </group>
                <footer>
                    <button name="action_generate_label" type="object" string="Générer l'étiquette"
                            class="btn-primary" invisible="state == 'done'"/>
                    <button string="Fermer" special="cancel" class="btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="chronopost_return_label_wizard_action" model="ir.actions.act_window">
        <field name="name">Étiquette de retour Chronopost</field>
        <field name="res_model">chronopost.return.label.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
