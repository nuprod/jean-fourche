<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_upcoming_payment" inherit_id="portal.side_content" name="Prélèvement à venir">
        <xpath expr="//a[@href='/my/account']" position="after">
            <div t-if="upcoming_sepa_lines" class="mt-3 pt-3 border-top">
                <span class="small text-muted">Prélèvement(s) à venir</span>
                <t t-foreach="upcoming_sepa_lines" t-as="line">
                    <div class="d-flex justify-content-between align-items-baseline mt-1">
                        <span class="small text-muted">
                            <t t-esc="line['date']"/>
                        </span>
                        <span class="fw-bold">
                            <t t-esc="line['amount_str']"/>
                        </span>
                    </div>
                </t>
            </div>
        </xpath>
    </template>
</odoo>
