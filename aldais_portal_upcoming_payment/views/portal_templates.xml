        <xpath expr="//a[@href='/my/account']" position="after">
            <div class="mt-3 pt-3 border-top">
                <span class="small text-muted">Prélèvement à venir</span>
                <div class="fw-bold fs-5">
                    <t t-esc="formatLang(upcoming_sepa_amount, currency_obj=upcoming_sepa_currency)"/>
