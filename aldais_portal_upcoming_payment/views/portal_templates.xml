<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_upcoming_payment" inherit_id="portal.side_content" name="Prélèvement à venir">
        <xpath expr="//a[@href='/my/account']" position="after">
            <t t-if="upcoming_sepa_amount">
                <div class="mt-3 pt-3 border-top">
                    <span class="small text-muted">Prélèvement à venir</span>
                    <div class="fw-bold fs-5">
                        <t t-esc="formatLang(upcoming_sepa_amount, currency_obj=upcoming_sepa_currency)"/>
                    </div>
                </div>
            </t>
        </xpath>
    </template>
</odoo>
