<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_sale_integration_form_order_line_metafields" model="ir.ui.view">
            <field name="name">sale.integration.form.order.line.metafields</field>
            <field name="model">sale.integration</field>
            <field name="inherit_id" ref="integration_shopify.view_sale_integration_form"/>
            <field name="arch" type="xml">
                <group name="sale_order_metafields_mappings" position="after">
                    <group string="Order Line Custom Attributes Mappings"
                           name="sale_order_line_metafields_mappings"
                           invisible="not is_integration_shopify">
                        <div colspan="2">
                            <p>
                                Shopify does not support metafields on order line items: use the table below to
                                map Shopify line item custom attributes ("line item properties" -- free-form
                                key/value pairs set at cart/checkout time, e.g. a gift message or an engraving
                                note) to fields on the sale.order.line model in Odoo.
                            </p>
                            <p>
                                There is no auto-discovery for these keys (Shopify does not expose a list of
                                possible custom attribute keys). Create a row below and type the exact key used
                                in Shopify.
                            </p>
                        </div>
                        <field name="order_line_metafield_mapping_ids" colspan="2" nolabel="1"
                               context="{
                                   'default_type': 'order_line',
                                   'default_metafield_type': 'single_line_text_field',
                               }">
                            <tree editable="bottom">
                                <field name="integration_id" column_invisible="1"/>
                                <field name="filtered_odoo_fields" column_invisible="1"/>
                                <field name="metafield_type" column_invisible="1"/>
                                <field name="metafield_id"
                                       domain="[('type', '=', 'order_line'), ('integration_id', '=', integration_id)]"
                                       context="{
                                           'default_type': 'order_line',
                                           'default_integration_id': integration_id,
                                           'default_metafield_type': 'single_line_text_field',
                                       }"
                                       options="{'no_open': True}"/>
                                <field name="metafield_key" string="Shopify Custom Attribute Key"/>
                                <field name="odoo_field_id"
                                       options="{'no_open': True, 'no_create': True}"
                                       required="metafield_id != False"/>
                            </tree>
                        </field>
                    </group>
                </group>
            </field>
        </record>

    </data>
</odoo>
