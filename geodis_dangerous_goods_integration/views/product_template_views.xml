<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="product_product_form_view_inherit_dangerous_goods" model="ir.ui.view">
        <field name="name">product.product.form.dangerous.goods</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Dangerous Goods">
                    <field name="dangerous_goods_line_ids">
                        <tree editable="bottom">
                            <field name="no_onu"/>
                            <field name="groupe_emballage"/>
                            <field name="classe_adr"/>
                            <field name="code_type_emballage"/>
                            <field name="nom_technique"/>
                            <field name="code_quantite"/>
                            <field name="danger_env"/>
                            <field name="poids_matiere_dangereuse"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
