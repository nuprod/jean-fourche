<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_picking_form_inherit_dangerous_goods_json" model="ir.ui.view">
        <field name="name">stock.picking.form.dangerous.goods.json</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='carrier_id']" position="after">
                <field name="dangerous_goods_json" readonly="1" widget="text"/>
            </xpath>
        </field>
    </record>
</odoo>
