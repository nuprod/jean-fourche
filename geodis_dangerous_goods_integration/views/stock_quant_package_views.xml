<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_quant_package_form_inherit_dangerous_goods" model="ir.ui.view">
        <field name="name">stock.quant.package.form.dangerous.goods</field>
        <field name="model">stock.quant.package</field>
        <field name="inherit_id" ref="stock.view_quant_package_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='shipping_weight']" position="after">
                <field name="contains_dangerous_goods" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
