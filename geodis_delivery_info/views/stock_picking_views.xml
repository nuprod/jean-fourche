<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <data>
        <record id="view_picking_form_delivery_info" model="ir.ui.view">
            <field name="name">stock.picking.form.delivery.info</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form"/>
            <field name="arch" type="xml">
                <!--
                    Ajout du champ "Information de livraison" directement sur la fiche
                    livraison, après le champ partenaire de livraison.
                -->
                <xpath expr="//field[@name='partner_id']" position="after">
                    <field name="delivery_info"
                           placeholder="Information de livraison (ex : sonnez à l'interphone B, dépôt en réception)..."
                           widget="text"/>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
