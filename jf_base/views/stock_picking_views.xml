<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_jf_base" model="ir.ui.view">
        <field name="name">stock.picking.form.jf.base</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_validate']" position="before">
                <button
                    name="action_force_confirm"
                    string="Forcer confirmation"
                    type="object"
                    class="btn-secondary"
                    invisible="state not in ('confirmed', 'assigned')"
                />
            </xpath>
        </field>
    </record>
</odoo>
