<odoo>
    <record id="res_config_settings_view_form_inherit_jf_quality" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.jf.quality</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="stock.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='warehouse']" position="after">
                <block title="Qualité" name="jf_quality_block">
                    <setting id="jf_supplier_return_operation_type"
                             string="Type d'opération retour fournisseur"
                             help="Type d'opération utilisé pour générer un retour fournisseur depuis une alerte qualité.">
                        <field name="jf_supplier_return_picking_type_id" options="{'no_create': True}"/>
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
